local function actionButton(parent, name, text, col, order)
    local b = Instance.new("TextButton")
    b.Name = name; b.Parent = parent
    b.BackgroundColor3 = T.Card
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.LayoutOrder = order or 1
    b.Font = Enum.Font.GothamMedium
    b.Text = text
    b.TextColor3 = T.Text
    b.TextScaled = true
    b.TextWrapped = false
    b.TextXAlignment = Enum.TextXAlignment.Center
    b.TextYAlignment = Enum.TextYAlignment.Center
    b.ClipsDescendants = true
    baseText(b, 12)
    corner(b, 8)
    local st = stroke(b, col, 1, 0.55)

    local accentDot = frame(b, "Accent", UDim2.new(0, 10, 0.5, -3), UDim2.new(0, 6, 0, 6), col)
