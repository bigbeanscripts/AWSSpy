function renderDetails(id)
    local data = CalledFunctions[id]
    if not data then return end

    for _, c in ipairs(VariantBar:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end

    local list = {}
    for _, k in ipairs(data.variantOrder) do
        if data.variants[k] then table.insert(list, data.variants[k]) end
    end
    if #list == 0 then return end

    local active = data.variants[SelectedVariantKey] or list[1]
    SelectedVariantKey     = active.key
    SelectedFullPath       = data.fullPath
    SelectedArgs           = active.args
    SelectedRawArgs        = active.rawArgs
    SelectedRemoteInstance = active.remoteInstance

    for i, v in ipairs(list) do
        local blocked = (BlockedFunctions[getCallSignature(data.fullPath, v.rawArgs or v.args)]
            or (v.remoteInstance and BlockedRemoteInstances[v.remoteInstance])) and true or false
        variantChip((blocked and "⛔ " or "") .. "Variant " .. i, v.key == SelectedVariantKey, function()
            SelectedVariantKey = v.key
            renderDetails(id)
        end)
    end

    local sig = getCallSignature(data.fullPath, SelectedRawArgs or SelectedArgs)
    local blocked  = (BlockedFunctions[sig] or (SelectedRemoteInstance and BlockedRemoteInstances[SelectedRemoteInstance])) and true or false
    local excluded = ExcludedFunctions[sig] and true or false

    BlockButton.Text   = blocked and "Unblock" or "Block"
    ExcludeButton.Text = excluded and "Include" or "Exclude"
    tw(BlockDot,   {BackgroundColor3 = blocked and T.Success or T.Danger})
    tw(ExcludeDot, {BackgroundColor3 = excluded and T.Violet or T.Accent})

    local args   = active.rawArgs or active.args or {}
    local method = data.fullPath:match(":(%w+)$") or "FireServer"
    local sample = buildRemoteCallCode(active.remoteInstance, method, args)
    local source = active.sourceScript and active.sourceScript:GetFullName() or "unavailable"
    local trace  = active.traceback or "Traceback unavailable"

    local ups = "  <none or unavailable>"
    if active.upvalues and next(active.upvalues) then
        local parts = {}
        for n, v in pairs(active.upvalues) do
            table.insert(parts, "  " .. tostring(n) .. " = " .. describeValue(v))
        end
        ups = table.concat(parts, "\n")
    end

    local function section(label, body, col)
        return ('<font color="#8A91A5">%s</font>\n<font color="%s">%s</font>\n\n')
            :format(label:upper(), col, escapeRich(body))
    end

    local d = ('<font color="#E9ECF4"><b>%s</b></font>\n'):format(escapeRich(data.fullPath))
    d ..= ('<font color="#8A91A5">%s  •  %d variant(s)%s</font>\n\n')
        :format(os.date("%H:%M:%S", data.time), #list,
                blocked and '  •  <font color="#E95B65">BLOCKED</font>' or "")

    d ..= '<font color="#8A91A5">PARAMETERS</font>\n'
    if #args > 0 then
        for i, a in ipairs(args) do
            d ..= ('  <font color="#8A91A5">%d</font>  <font color="#A370F6">%s</font>\n')
                :format(i, escapeRich(formatValue(a)))
        end
    else
        d ..= '  <font color="#8A91A5">none</font>\n'
    end

    d ..= '\n'
    d ..= section("Filter signature", sig, "#8A91A5")
    d ..= section("Calling script", source, "#6885FF")
    d ..= section("Traceback", trace, "#EEB046")
    d ..= section("Caller upvalues", ups, "#48C78E")

    d ..= ('\n<font color="#8A91A5">SAMPLE CODE</font>\n<font color="#48C78E">%s</font>')
        :format(escapeRich(sample))

    DetailsText.Text = d
end

local function selectEntry(id)
    for otherId, d in pairs(CalledFunctions) do
        if d.entry then
            tw(d.entry, {BackgroundColor3 = (otherId == id) and T.Hover or T.Card})
        end
    end
    SelectedId = id
    SelectedVariantKey = nil
    renderDetails(id)
end

local function entryMatchesSearch(id, data, q)
    if q == "" then return true end
    local hay = (id or ""):lower()
    for _, k in ipairs(data.variantOrder) do
        local v = data.variants[k]
        if v then
            local variantPath = v.remoteInstance and v.remoteInstance:GetFullName() or ""
            local variantArgs = argsToSearchText(v.rawArgs or v.args or {})
            local variantText = (k or "") .. " " .. variantArgs .. " " .. (variantPath or "")
            hay = hay .. " " .. variantText:lower()
        end
    end
    return string.find(hay, q, 1, true) ~= nil
end

local function createLogEntry(fullPath, args, rawArgs, remoteInstance, sourceScript, traceback, upvalues, wasBlocked)
    local sig = getCallSignature(fullPath, rawArgs or args)
    if ExcludedFunctions[sig] or ExcludedFunctions[fullPath] then return end

    local id          = fullPath
    local variantKey  = argsToKey(rawArgs or args or {})
    local serviceName = fullPath:match("Network:(%w+)")
        or (remoteInstance and remoteInstance.Parent and remoteInstance.Parent.Name)
        or "Network"

    local data = CalledFunctions[id]
    if not data then
        data = {
            fullPath     = fullPath,
            serviceName  = serviceName,
            serviceColor = getServiceColor(serviceName),
            variants     = {},
            variantOrder = {},
            time         = os.time(),
        }
        CalledFunctions[id] = data
    end

    local v = data.variants[variantKey]
    if not v then
        v = { key = variantKey }
        data.variants[variantKey] = v
        table.insert(data.variantOrder, variantKey)
    end
    v.args, v.rawArgs, v.remoteInstance = args, rawArgs, remoteInstance
    v.sourceScript, v.upvalues, v.time  = sourceScript, upvalues, os.time()
    v.blocked = wasBlocked and true or false
    if traceback and traceback ~= "" then v.traceback = traceback end

    data.time = os.time()
    callTracebacks[fullPath .. "|" .. variantKey] = traceback

    if not data.entry then
        local entry = Template:Clone()
        entry.Name = id
        entry.FunctionName.Text = getRemoteDisplayName(fullPath)
        entry.ColorBar.BackgroundColor3 = data.serviceColor
        entry.MouseEnter:Connect(function()
            if SelectedId ~= id then tw(entry, {BackgroundColor3 = T.Hover}) end
        end)
        entry.MouseLeave:Connect(function()
            if SelectedId ~= id then tw(entry, {BackgroundColor3 = T.Card}) end
        end)
        entry.MouseButton1Click:Connect(function() selectEntry(id) end)
        entry.Parent = FunctionList
        data.entry = entry

        local n = 0
        for _ in pairs(CalledFunctions) do n += 1 end
        CountLabel.Text = n .. (n == 1 and " REMOTE" or " REMOTES")
        updateScale()
    end

    data.entry.Badge.BadgeText.Text = tostring(#data.variantOrder)
    refreshEntryStyle(data)

    if SearchBar.Text ~= "" then
        data.entry.Visible = entryMatchesSearch(id, data, normalizeSearchText(SearchBar.Text))
    else
        data.entry.Visible = true
    end
    if SelectedId == id then renderDetails(id) end
end

local function scanAndHookNetwork()
    if typeof(hookmetamethod) ~= "function" then
        updateStatus("hookmetamethod unavailable", true)
        return
    end

    oldNamecall = hookmetamethod(
        game,
        "__namecall",
        newcclosure(function(self, ...)
            local method = getnamecallmethod()

            if method == "FireServer" or method == "InvokeServer" then
                if not checkcaller() then
                    local args = { ... }
                    local sourceScript = getCallingScript()
                    local traceback = getTraceback()
                    local callerFunction = getCallerFunction()
                    local upvalues = getCallerUpvalues(callerFunction)

                    local blocked, blockedPath = false, nil
                    if next(BlockedRemoteInstances) ~= nil then
                        for remoteTarget, _ in pairs(BlockedRemoteInstances) do
                            if self == remoteTarget and (method == "FireServer" or method == "InvokeServer") then
                                blocked = true
                                blockedPath = tostring(remoteTarget:GetFullName()) .. ":" .. method
                                break
                            end
                        end
                    end

                    if not blocked and next(BlockedFunctions) ~= nil then
                        local ok, path = pcall(function() return self:GetFullName() end)
                        if ok then
                            blockedPath = tostring(path) .. ":" .. method
                            local directMatch = isDirectlyBlockedRemote(self, blockedPath, method, args)
                            if directMatch then
                                blocked = true
                            else
                                blocked = BlockedFunctions[blockedPath]
                                    or BlockedFunctions[getCallSignature(blockedPath, args)]
                            end
                        end
                    end

                    if not IsPaused then
                        local remote = self
                        local wasBlocked = blocked
                        task.spawn(function()
                            local fullPath = blockedPath or (tostring(remote:GetFullName()) .. ":" .. method)
                            pcall(createLogEntry, fullPath, args, args, remote,
                                  sourceScript, traceback, upvalues, wasBlocked)
                            if PRINT_TO_CONSOLE then
                                logRemote(remote, method, args, sourceScript, traceback, upvalues)
                            end
                        end)
                    end

                    if blocked then
                        if method == "FireServer" then
                            return
                        elseif BLOCK_INVOKES then
                            return nil
                        end
                    end
                end
            end

            return oldNamecall(self, ...)
        end)
    )
end

local function executeFullPath(fullPath, args, remoteInstance)
    local method = fullPath:match(":(%w+)$") or "FireServer"
    if typeof(remoteInstance) ~= "Instance" then
        return false, "Unknown remote"
    end

    local sig = getCallSignature(fullPath, args)
    if BlockedFunctions[sig]
        or BlockedFunctions[fullPath]
        or BlockedFunctions[fullPath .. ":" .. method]
        or BlockedRemoteInstances[remoteInstance] then
        return false, "Function is blocked"
    end
    local ok, err = pcall(function()
        if method == "InvokeServer" then
            remoteInstance:InvokeServer(unpack(args or {}))
        else
            remoteInstance:FireServer(unpack(args or {}))
        end
    end)
    return ok, err
end

local function splitLines(s)
    local t = {}
    for l in s:gmatch("([^\r\n]*)\r?\n?") do table.insert(t, l) end
    if #t > 0 and t[#t] == "" then table.remove(t) end
    return t
end

local function generateDeepCopy(fullPath, args)
    local out = {}
    local function add(s) table.insert(out, s) end

    local data    = CalledFunctions[fullPath]
    local variant = data and data.variants[SelectedVariantKey]
    local remote  = variant and variant.remoteInstance
    local method  = fullPath:match(":(%w+)$") or "FireServer"
    local trace   = callTracebacks[fullPath .. "|" .. argsToKey(args or {})]

    add(("=== %s ==="):format(fullPath))
    add("")
    add("--- RUNTIME CALL ---")
    add(buildRemoteCallCode(remote, method, args))
    add("")

    if trace and trace ~= "" then
        add("--- TRACEBACK ---")
        add(trace)
        add("")
    end

    if typeof(decompile) ~= "function" then
        add("decompile() unavailable in this environment — source search skipped.")
        return table.concat(out, "\n")
    end

    local paths, seenPaths = {}, {}
    for line in (trace or ""):gmatch("[^\r\n]+") do
        local path = line:match("^([^:]+):%d+")
        if path and not path:find("_Index", 1, true) and not seenPaths[path] then
            seenPaths[path] = true
            table.insert(paths, path)
        end
    end

    local found, failed = {}, 0
    for _, path in ipairs(paths) do
        local target
        for _, obj in ipairs(game:GetDescendants()) do
            if (obj:IsA("ModuleScript") or obj:IsA("LocalScript"))
                and obj:GetFullName() == path then
                target = obj
                break
            end
        end

        if target then
            local ok, source = pcall(decompile, target)
            if ok and source then
                table.insert(found, {path = path, source = source})
            else
                failed += 1
            end
        else
            failed += 1
        end
    end

    add(("--- DECOMPILED: %d, failed: %d ---"):format(#found, failed))
    add("")

    for _, result in ipairs(found) do
        add("=== " .. result.path .. " ===")
        add("")
        add(result.source)
        add("")
    end

    local res = table.concat(out, "\n")
    return res
end

local function splitClipboardChunks(text)
    local chunks = {}
    local startIndex = 1
    local maxLength = 10000

    while startIndex <= #text do
        local endIndex = math.min(startIndex + maxLength - 1, #text)
        if endIndex < #text then
            local lastNewline = text:sub(startIndex, endIndex):match(".*()\n")
            if lastNewline and lastNewline > 1 then
                endIndex = startIndex + lastNewline - 1
            end
        end
        table.insert(chunks, text:sub(startIndex, endIndex))
        startIndex = endIndex + 1
    end

    return chunks
end

