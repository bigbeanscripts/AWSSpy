SearchBar:GetPropertyChangedSignal("Text"):Connect(function()
    local q = normalizeSearchText(SearchBar.Text)
    local matchedId
    local matchedVariant

    for id, d in pairs(CalledFunctions) do
        if d.entry then
            local hay = normalizeSearchText(id or "")
            local bestVariant

            for _, k in ipairs(d.variantOrder) do
                local v = d.variants[k]
                if v then
                    local variantPath = v and v.remoteInstance and v.remoteInstance:GetFullName() or ""
                    local variantText = (k or "") .. " " .. argsToSearchText(v and (v.rawArgs or v.args) or {}) .. " " .. variantPath
                    local normalizedVariantText = normalizeSearchText(variantText)
                    hay = hay .. " " .. normalizedVariantText

                    if q ~= "" and string.find(normalizedVariantText, q, 1, true) ~= nil then
                        if not matchedId then
                            matchedId = id
                            matchedVariant = k
                        end
                        if not bestVariant then
                            bestVariant = k
                        end
                    end
                end
            end

            local visible = q == "" or string.find(hay, q, 1, true) ~= nil
            d.entry.Visible = visible

            if q ~= "" and visible and not matchedId then
                matchedId = id
                matchedVariant = bestVariant or d.variantOrder[1]
            end
        end
    end

    if q == "" then
        if SelectedId and CalledFunctions[SelectedId] and CalledFunctions[SelectedId].entry then
            renderDetails(SelectedId)
        end
        return
    end

    if matchedId and matchedVariant then
        SelectedId = matchedId
        SelectedVariantKey = matchedVariant
        renderDetails(matchedId)
    elseif SelectedId and CalledFunctions[SelectedId] and CalledFunctions[SelectedId].entry then
        local currentVisible = CalledFunctions[SelectedId].entry.Visible
        if currentVisible then
            renderDetails(SelectedId)
        end
    end
end)

