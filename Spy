--==================== SCREEN CLAMPING ====================
local function getViewportSize()
    local camera = workspace.CurrentCamera
    return camera and camera.ViewportSize or Vector2.new(1280, 720)
end

local function clampMainPosition(x, y, w, h)
    local vp = getViewportSize()
    local maxX = math.max(vp.X - w, 0)
    local maxY = math.max(vp.Y - h, 0)
    return math.clamp(x, 0, maxX), math.clamp(y, 0, maxY)
end

local function bindViewportClamp()
    local camera = workspace.CurrentCamera
    if not camera then return end
    camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
        local x, y = clampMainPosition(Main.AbsolutePosition.X, Main.AbsolutePosition.Y, Main.AbsoluteSize.X, Main.AbsoluteSize.Y)
        Main.Position = UDim2.new(0, x, 0, y)
    end)
end
bindViewportClamp()
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindViewportClamp)

