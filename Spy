local function describeBlockedTarget(fullPath, remoteInstance)
    local path = tostring(fullPath or (remoteInstance and remoteInstance:GetFullName()) or "<unknown>")
    if path == "<unknown>" then
        return path
    end
    return path:gsub("^game%.", "")
end

local function getServiceColor(serviceName)
    if not serviceColors[serviceName] then
        serviceColors[serviceName] = PALETTE[serviceColorIndex]
        serviceColorIndex = serviceColorIndex % #PALETTE + 1
    end
    return serviceColors[serviceName]
end

local function getInstancePath(instance)
    if not instance then return "nil" end
    if not instance.Parent then
        local ok, id = pcall(function() return instance:GetDebugId() end)
        return ('GetNil("%s", "%s")'):format(instance.Name, ok and id or "unknown")
    end
    local path, current, lp = {}, instance, Players.LocalPlayer
    while current and current ~= game do
        if current == lp then table.insert(path, 1, 'game:GetService("Players").LocalPlayer'); break end
        if current.Parent == game then table.insert(path, 1, ('game:GetService("%s")'):format(current.ClassName)); break end
        local n = current.Name
        if n:match("^[_a-zA-Z][_a-zA-Z0-9]*$") then
            table.insert(path, 1, "." .. n)
        else
            table.insert(path, 1, '["' .. n:gsub('"', '\\"') .. '"]')
        end
        current = current.Parent
    end
    local res = table.concat(path, "")
    if res:sub(1, 1) == "." then res = "game" .. res end
    return res
end

local function escapeRich(s)
    return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function formatValue(val, depth)
    depth = depth or 0
    if depth > 3 then return "..." end
    local t = typeof(val)
    if t == "string" then
        return '"' .. val:gsub('"', '\\"'):gsub("\n", "\\n") .. '"'
    elseif t == "number" or t == "boolean" or t == "nil" then
        return tostring(val)
    elseif t == "Instance" then
        return getInstancePath(val)
    elseif t == "table" then
        local items, count = {}, 0
        for k, v in pairs(val) do
            count += 1
            if count > 10 then table.insert(items, "..."); break end
            local key
            if typeof(k) == "string" and k:match("^[%a_][%w_]*$") then key = k
            elseif typeof(k) == "string" then key = '["' .. k .. '"]'
            else key = "[" .. formatValue(k, depth + 1) .. "]" end
            table.insert(items, key .. " = " .. formatValue(v, depth + 1))
        end
        return #items == 0 and "{}" or "{" .. table.concat(items, ", ") .. "}"
    elseif t == "Vector3" then
        return ("Vector3.new(%.2f, %.2f, %.2f)"):format(val.X, val.Y, val.Z)
    elseif t == "Vector2" then
        return ("Vector2.new(%.2f, %.2f)"):format(val.X, val.Y)
    elseif t == "Color3" then
        return ("Color3.new(%.3f, %.3f, %.3f)"):format(val.R, val.G, val.B)
    elseif t == "UDim2" then
        return ("UDim2.new(%.2f, %d, %.2f, %d)"):format(val.X.Scale, val.X.Offset, val.Y.Scale, val.Y.Offset)
    elseif t == "CFrame" then
        return "CFrame.new(" .. tostring(val.Position) .. ")"
    elseif t == "EnumItem" then
        return "Enum." .. tostring(val.EnumType) .. "." .. val.Name
    end
    return tostring(val)
end

local function formatArgs(args)
    if not args or #args == 0 then return "()" end
    local out = {}
    for _, a in ipairs(args) do table.insert(out, formatValue(a)) end
    return "(" .. table.concat(out, ", ") .. ")"
end

local function serializeKeyValue(value, seen)
    seen = seen or {}
    local vType = typeof(value)

    if value == nil then return "nil" end
    if vType == "string" then return "string:" .. value end
    if vType == "number" or vType == "boolean" then return vType .. ":" .. tostring(value) end
    if vType == "EnumItem" then return "enum:" .. tostring(value.EnumType) .. "." .. value.Name end
    if vType == "Instance" then
        local ok, full = pcall(function() return value:GetFullName() end)
        return ok and ("instance:" .. full) or ("instance:" .. tostring(value))
    end
    if vType == "table" then
        if seen[value] then return "<recursion>" end
        seen[value] = true
        local keys = {}
        for k in pairs(value) do table.insert(keys, tostring(k)) end
        table.sort(keys)

        local parts = {}
        for _, key in ipairs(keys) do
            local realKey = key
            local okKey = tonumber(key)
            local actualKey = okKey and okKey or key
            local item = value[actualKey]
            table.insert(parts, "[" .. serializeKeyValue(actualKey, seen) .. "]=" .. serializeKeyValue(item, seen))
        end
        seen[value] = nil
        return "table:{" .. table.concat(parts, ",") .. "}"
    end

    return vType .. ":" .. tostring(value)
end

local function argsToKey(args)
    if not args then return "" end
    local parts = {}
    for _, v in ipairs(args) do
        table.insert(parts, serializeKeyValue(v, {}))
    end
    return table.concat(parts, "|")
end

local function normalizeSearchText(s)
    local text = tostring(s or ""):lower()
    text = text:gsub("[%[%]()%{%}%[%]" .. '"' .. "'`]", " ")
    text = text:gsub("[^%w%s]", " ")
    text = text:gsub("%s+", " ")
    return text:match("^%s*(.-)%s*$") or ""
end

local function argsToSearchText(args)
    if not args then return "" end
    local out = {}

    local function addValue(value)
        if value == nil then return end
        local vType = typeof(value)
        local text = ""

        if vType == "Instance" then
            local ok, full = pcall(function() return value:GetFullName() end)
            text = ok and full or tostring(value)
        elseif vType == "string" then
            text = value
        elseif vType == "table" then
            local seen = {}
            local function walk(tbl)
                if typeof(tbl) ~= "table" then
                    return
                end
                if seen[tbl] then return end
                seen[tbl] = true
                for key, item in pairs(tbl) do
                    local keyText = tostring(key)
                    if typeof(key) == "string" then keyText = key end
                    table.insert(out, normalizeSearchText(keyText))
                    if item ~= nil then
                        addValue(item)
                    end
                end
            end
            walk(value)
            return
        else
            text = formatValue(value)
        end

        if text and text ~= "" then
            table.insert(out, normalizeSearchText(text))
        end
    end

    for _, value in ipairs(args) do
        addValue(value)
    end
    return table.concat(out, " ")
end

local function getRemoteDisplayName(fullPath)
    local path = tostring(fullPath or "")
    if path == "" then return "Remote" end

    local base = path:match("^(.-):[%w_]+$") or path
    local name = base:match("([%w_]+)$") or base
    if name == "" then
        name = path:gsub("^game%.", "")
    end
    return name
end

local function isStrictOnClickCall(path, method)
    if not path or not method then return false end
    local lowerPath = tostring(path):lower()
    local lowerMethod = tostring(method):lower()
    return lowerMethod == "fireserver"
        and string.find(lowerPath, "onclick", 1, true) ~= nil
        and string.find(lowerPath, ":fireserver", 1, true) ~= nil
end

local function isDirectlyBlockedRemote(remoteInstance, path, method, args)
    if typeof(remoteInstance) ~= "Instance" then
        return false
    end
    if method ~= "FireServer" and method ~= "InvokeServer" then
        return false
    end

    local fullPath = tostring(path or remoteInstance:GetFullName())
    if BlockedRemoteInstances[remoteInstance] then
        return true
    end

    if BlockedFunctions[fullPath] then
        return true
    end

    if BlockedFunctions[fullPath .. ":" .. method] then
        return true
    end

    if BlockedFunctions[getCallSignature(fullPath, args or {})] then
        return true
    end

    return false
end

local function getCallSignature(path, args)
    if not path then return "" end
    local sig = path
    local key = argsToKey(args or {})
    if key ~= "" then
        sig = sig .. "|" .. key
    end
    return sig
end

local function buildRemoteCallCode(remoteInstance, method, rawArgs)
    local args = rawArgs or {}
    if #args == 0 then
        return getInstancePath(remoteInstance) .. ":" .. method .. "()"
    end
    local code = "local args = {\n"
    for index, value in ipairs(args) do
        code = code .. string.format("    [%d] = %s,\n", index, formatValue(value))
    end
    code = code .. "}\n\n"
    code = code .. getInstancePath(remoteInstance) .. ":" .. method .. "(unpack(args))"
    return code
end

local function dumpTable(value, indent, visited)
    indent = indent or 0
    visited = visited or {}

    if visited[value] then
        print(string.rep("  ", indent) .. "<recursive table>")
        return
    end

    visited[value] = true

    for key, item in pairs(value) do
        local prefix = string.rep("  ", indent)

        if typeof(item) == "table" then
            print(prefix .. "[" .. tostring(key) .. "] (table):")
            dumpTable(item, indent + 1, visited)
        else
            print(string.format(
                "%s[%s] (%s): %s",
                prefix,
                tostring(key),
                typeof(item),
                tostring(item)
            ))
        end
    end

    visited[value] = nil
end

local function getCallingScript()
    if typeof(getcallingscript) ~= "function" then
        return nil
    end

    local success, result = pcall(getcallingscript)

    if success and typeof(result) == "Instance" then
        return result
    end

    return nil
end

local function getTraceback()
    local success, result = pcall(
        debug.traceback,
        "Remote call traceback",
        3
    )

    if success then
        return result
    end

    return "Traceback unavailable: " .. tostring(result)
end

local function getCallerFunction()
    local success, info = pcall(debug.getinfo, 3, "f")
    if success and info and info.func then
        return info.func
    end
    return nil
end

local function describeValue(value, depth, visited)
    depth = depth or 0
    visited = visited or {}

    if depth > 2 then
        return "<max depth>"
    end

    local valueType = typeof(value)

    if valueType == "string" then
        return string.format("%q", value)
    elseif valueType == "Instance" then
        local success, path = pcall(value.GetFullName, value)
        return success and path or "<Instance>"
    elseif valueType ~= "table" and valueType ~= "function" then
        return tostring(value)
    end

    if visited[value] then
        return "<recursive>"
    end
    visited[value] = true

    if valueType == "table" then
        local items = {}
        local count = 0

        for key, item in pairs(value) do
            count = count + 1
            if count > 20 then
                table.insert(items, "<more entries>")
                break
            end

            table.insert(items, string.format(
                "[%s] = %s",
                tostring(key),
                describeValue(item, depth + 1, visited)
            ))
        end

        visited[value] = nil
        return "{" .. table.concat(items, ", ") .. "}"
    end

    local functionInfo = {}
    local infoSuccess, info = pcall(debug.getinfo, value)
    if infoSuccess and info then
        table.insert(functionInfo, string.format(
            "source=%s, name=%s, line=%s",
            tostring(info.source),
            tostring(info.name),
            tostring(info.currentline)
        ))
    end

    if typeof(debug.getupvalue) == "function" then
        local index = 1
        while true do
            local success, name, upvalue = pcall(debug.getupvalue, value, index)
            if not success or not name then
                break
            end

            table.insert(functionInfo, string.format(
                "%s = %s",
                tostring(name),
                describeValue(upvalue, depth + 1, visited)
            ))
            index = index + 1
        end
    end

    visited[value] = nil
    return "function { " .. table.concat(functionInfo, "; ") .. " }"
end

local function getCallerUpvalues(callerFunction)
    local upvalues = {}
    if not callerFunction or typeof(debug.getupvalue) ~= "function" then
        return upvalues
    end

    local index = 1
    while true do
        local success, name, value = pcall(
            debug.getupvalue,
            callerFunction,
            index
        )

        if not success or not name then
            break
        end

        upvalues[name] = value
        index = index + 1
    end

    return upvalues
end

local function printUpvalues(upvalues)
    local found = false

    for name, value in pairs(upvalues or {}) do
        found = true
        print(string.format("  %s = %s", tostring(name), describeValue(value)))
    end

    if not found then
        print("  <none or unavailable>")
    end
end

local function logRemote(remote, method, args, sourceScript, traceback, upvalues)
    local success, errorMessage = pcall(function()
        print("========================================")
        print("[REMOTE]:", remote:GetFullName())
        print("[METHOD]:", method)

        if sourceScript then
            print("[CALLING SCRIPT]:", sourceScript:GetFullName())
            print("[MODULE/CONTROLLER]:", sourceScript.Name)
        else
            print("[CALLING SCRIPT]: unavailable")
            print("[MODULE/CONTROLLER]: unavailable")
        end

        print("[CALLER UPVALUES AND VALUES]:")
        printUpvalues(upvalues)

        print("[FULL TRACEBACK]:")
        print(traceback)

        print("[ARGUMENTS]:")

        if #args == 0 then
            print("  <none>")
        else
            for index, argument in ipairs(args) do
                if typeof(argument) == "table" then
                    print(string.format("  [%d] (table):", index))
                    dumpTable(argument, 2)
                else
                    print(string.format(
                        "  [%d] (%s): %s",
                        index,
                        typeof(argument),
                        tostring(argument)
                    ))
                end
            end
        end

        print("========================================")
    end)

    if not success then
        warn("[Remote logger error]:", errorMessage)
    end
end

