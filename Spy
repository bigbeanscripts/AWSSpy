local resizing, activeGrip, startSize, startAbsPos, startMouse
for name, g in pairs(Grips) do
    g.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            resizing, activeGrip = true, name
            startSize, startAbsPos = Main.AbsoluteSize, Main.AbsolutePosition
            startMouse = Vector2.new(input.Position.X, input.Position.Y)
        end
    end)
    g.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            resizing, activeGrip = false, nil
        end
    end)
end

UserInputService.InputChanged:Connect(function(input)
    if not resizing or not activeGrip then return end
    if input.UserInputType ~= Enum.UserInputType.MouseMovement
    and input.UserInputType ~= Enum.UserInputType.Touch then return end

    local delta = Vector2.new(input.Position.X, input.Position.Y) - startMouse
    local w, h = startSize.X, startSize.Y

    if activeGrip:find("Right")  then w = startSize.X + delta.X end
    if activeGrip:find("Left")   then w = startSize.X - delta.X end
    if activeGrip:find("Bottom") then h = startSize.Y + delta.Y end
    if activeGrip:find("Top")    then h = startSize.Y - delta.Y end

    w = math.clamp(w, 620, 1500)
    h = math.clamp(h, 400, 950)

    local x = activeGrip:find("Left") and (startAbsPos.X + (startSize.X - w)) or startAbsPos.X
    local y = activeGrip:find("Top")  and (startAbsPos.Y + (startSize.Y - h)) or startAbsPos.Y

    Main.Position = UDim2.new(0, x, 0, y)
    Main.Size = UDim2.new(0, w, 0, h)
end)

