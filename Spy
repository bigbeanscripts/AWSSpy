local function grip(name, visible)
    local g = Instance.new("Frame")
    g.Name = name; g.Parent = Gui
    g.Size = UDim2.new(0, 16, 0, 16)
    g.BackgroundColor3 = T.Accent
    g.BackgroundTransparency = visible and 0.4 or 1
